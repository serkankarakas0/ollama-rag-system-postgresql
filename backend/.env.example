# Ollama (tamamen lokal, ücretsiz, API anahtarı gerekmez)
# Model listesi: https://ollama.com/library
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434

# PostgreSQL bağlantı bilgileri (lokal kurulumunuza göre düzenleyin)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rag_db_ollama
DB_USER=example
DB_PASSWORD=

# Embedding modeli (lokal, ücretsiz, sentence-transformers üzerinden çalışır)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Chunking ayarları
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
